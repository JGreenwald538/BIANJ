{
  "include": [
    "."
  ],
  "exclude": [
    "./server",
    "./node_modules",
    "./android",
    "./ios",
    "./dist",
    "./babel.config.js",
    "./metro.config.js",
    "./react-native.config.js"
  ],
  "compilerOptions": {
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "extends": "expo/tsconfig.base"
}
