# Files not needed by EAS Build. Keeping them out of the upload keeps the
# project archive small; without this it is ~215 MB.
#
# Note: .easignore fully replaces .gitignore for build uploads, so the
# gitignored entries that matter have to be repeated here.

# Previously built artifacts checked into the repo
build-*.ipa
build-*.aab
*.apk

# Local build output and caches
dist/
.expo/
web-build/
node_modules/

# Native projects are regenerated by prebuild on the builder
android/
ios/

# Signing material (EAS uses the credentials stored server-side)
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
credentials/
credentials.json

# Local env and editor state
.env*
.vscode/
.DS_Store
